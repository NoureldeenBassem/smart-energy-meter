# Copy this file to backend/.env and fill in real values.
#   PowerShell:  Copy-Item backend\.env.example backend\.env
#
# backend/.env is gitignored — never commit real secrets.

# Postgres. Port 15432 matches the host-side mapping in docker-compose.yml
# ("15432:5432"), so this works against the containerised database.
DATABASE_URL=postgresql://smart_meter_user:smart_meter_pass@localhost:15432/smart_meter

# JWT signing key — read by app/core/security.py.
# Generate a fresh one for any real deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value

# MQTT broker — read by app/workers/telemetry_worker.py.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_FILTER=home/+/telemetry
