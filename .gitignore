# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
venv/
backend/venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Secrets — never commit real credentials.
# backend/.env holds the JWT SECRET_KEY and DB password.
# Commit backend/.env.example instead (checked in, placeholder values only).
# ---------------------------------------------------------------------------
.env
*.env
!*.env.example
!.env.example

# Locally minted JWTs used for manual endpoint testing. These are real,
# long-lived bearer tokens — never commit one.
backend/token.txt
token.txt

# ---------------------------------------------------------------------------
# Large datasets — the UCI household power consumption file is ~133 MB,
# well over GitHub's 100 MB per-file hard limit. It is a public dataset:
# download instructions live in the README, and
# backend/ml/training/prepare_public_dataset.py regenerates everything
# downstream of it.
# ---------------------------------------------------------------------------
backend/ml/data/household_power_consumption.txt
backend/ml/data/*.zip

# Generated feature tables — reproducible from the raw dataset above via
#   python -m ml.training.prepare_public_dataset              (sliding, stride 5)
#   python -m ml.training.prepare_public_dataset --stride 30 --out ml/data/rows_disjoint.csv
backend/ml/data/training_rows.csv
backend/ml/data/rows_disjoint.csv

# NOTE: backend/ml/models/*.pkl is deliberately NOT ignored. The trained
# model artifact is part of the submission deliverable so judges can run
# predictions without retraining.

# ---------------------------------------------------------------------------
# Node / Next.js  (frontend/.gitignore covers these in more detail)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Design canvas: the .dc.html artboards and canvas.json ARE the source and are
# committed. The seeded output is a ~2 MB generated bundle rebuilt from them on
# every change, so it is not.
# ---------------------------------------------------------------------------
design/*.html
!design/*.dc.html
